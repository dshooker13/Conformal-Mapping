Notebook[{
Cell[CellGroupData[{
Cell["Conformal Mapping Tool", "Title"],
Cell["Solve two-dimensional electrostatics problems with conformal maps, and watch the maps work", "Subtitle"],
Cell["Version 2.0.0 \[CenterDot] Daniel Hooker (dshooker@mail.fresnostate.edu)", "Text"],
Cell["Describe some conductors (curves held at fixed potentials), then build a chain of conformal maps w1, w2, ... . The tool carries the region between the conductors through every map so you can see what each one does. When every conductor lands on a straight line Re w = V (or Im w = V), the problem is solved: the potential in the region is V(x, y) = Re W(x + i y), where W is the composite map, and its equipotentials and field lines are drawn in every plane.", "Text"],
Cell[CellGroupData[{
Cell["Start here", "Section"],
Cell["Click the cell below and press Shift+Enter. If Mathematica asks whether to evaluate the initialization cells, choose Yes.", "Item"],
Cell["Pick a problem from Load example, or describe your own conductors in section 1 of the tool.", "Item"],
Cell["Add maps in section 2. Use the animation controls under the right-hand plot to watch the region travel from the z-plane to the final plane.", "Item"],
Cell["The table under the plots checks every conductor. When every row is satisfied, the potential, the equipotentials and the field lines appear.", "Item"],
Cell[BoxData[RowBox[{"ConformalMapTool", "[", "]"}]], "Input"]
}, Open]],
Cell[CellGroupData[{
Cell["More examples", "Section"],
Cell["Each cell below opens the tool with a worked example loaded. The same examples are in the tool's Load example menu.", "Text"],
Cell[BoxData[RowBox[{"ConformalMapTool", "[", "\"\<Two wires inside a shell\>\"", "]"}]], "Input"],
Cell[BoxData[RowBox[{"ConformalMapTool", "[", "\"\<Two parallel wires\>\"", "]"}]], "Input"],
Cell[BoxData[RowBox[{"ConformalMapTool", "[", "\"\<Blank\>\"", "]"}]], "Input"]
}, Open]],
Cell[CellGroupData[{
Cell["Implementation", "Section"],
Cell["These are initialization cells: Mathematica runs them automatically the first time the tool is used in a session. You do not need to read them to use the tool. The code is grouped as: settings and examples, reading what the user typed, geometry (sampling curves, deciding what is inside the region, pushing points through the maps), solving (checking the boundary conditions and finding level curves), drawing, and the interface.", "Text"],
Cell[CellGroupData[{
Cell["Settings", "Subsection"],
Cell[BoxData[RowBox[{"$cmtVersion", "=", "\"\<2.0.0\>\"", ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"(*", " ", RowBox[{"Values", " ", "larger", " ", "than", " ", "this", " ", "are", " ", "treated", " ", "as", " ", "having", " ", "been", " ", "sent", " ", "to", " ", "infinity."}], " ", "*)"}], "\[IndentingNewLine]", "$cmtBig", "=", "10.", "^", "8", ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"(*", " ", RowBox[{"Settings", " ", "that", " ", "change", " ", "what", " ", "has", " ", "to", " ", "be", " ", "computed."}], " ", "*)"}], "\[IndentingNewLine]", "$cmtDefaultSettings", "=", RowBox[{"<|", RowBox[{RowBox[{"\"\<BoundaryPoints\>\"", "->", "400"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Resolution\>\"", "->", "61"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<GridLines\>\"", "->", "12"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<GridLinePoints\>\"", "->", "300"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Equipotentials\>\"", "->", "9"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<FieldLines\>\"", "->", "12"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Refine\>\"", "->", "True"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<ForceSolution\>\"", "->", "False"}]}], "|>"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"(*", " ", RowBox[{"Settings", " ", "that", " ", "only", " ", "change", " ", "how", " ", "things", " ", "are", " ", "drawn."}], " ", "*)"}], "\[IndentingNewLine]", "$cmtDefaultView", "=", RowBox[{"<|", RowBox[{RowBox[{"\"\<Shading\>\"", "->", "True"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Checkerboard\>\"", "->", "False"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Grid\>\"", "->", "True"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Equipotentials\>\"", "->", "True"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<FieldLines\>\"", "->", "True"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<ZoomLevel\>\"", "->", "0"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Trace\>\"", "->", "False"}], ",", "\[IndentingNewLine]", RowBox[{"\"\<TraceT\>\"", "->", "0.25"}]}], "|>"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "$cmtRoleLabels", "=", RowBox[{"{", RowBox[{RowBox[{"\"\<Hole\>\"", "->", "\"\<conductor inside the region\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Outer\>\"", "->", "\"\<outer boundary of the region\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Curve\>\"", "->", "\"\<open curve (encloses nothing)\>\""}]}], "}"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "$cmtRoleShort", "=", RowBox[{"<|", RowBox[{RowBox[{"\"\<Hole\>\"", "->", "\"\<inside region\>\""}], ",", RowBox[{"\"\<Outer\>\"", "->", "\"\<outer boundary\>\""}], ",", RowBox[{"\"\<Curve\>\"", "->", "\"\<open curve\>\""}]}], "|>"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "$cmtCommonMaps", "=", RowBox[{"{", RowBox[{RowBox[{"\"\<Shift: z - 1\>\"", "->", RowBox[{"Hold", "[", RowBox[{"z", "-", "1"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Rotate and scale: 2 I z\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "I", " ", "z"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Inversion: 1/z\>\"", "->", RowBox[{"Hold", "[", RowBox[{"1", "/", "z"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<M\[ODoubleDot]bius: (z - 1)/(z + 1)\>\"", "->", RowBox[{"Hold", "[", RowBox[{RowBox[{"(", RowBox[{"z", "-", "1"}], ")"}], "/", RowBox[{"(", RowBox[{"z", "+", "1"}], ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Logarithm: Log[z]\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Log", "[", "z", "]"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Exponential: Exp[z]\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Exp", "[", "z", "]"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Square: z^2\>\"", "->", RowBox[{"Hold", "[", RowBox[{"z", "^", "2"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Square root: Sqrt[z]\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Sqrt", "[", "z", "]"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Joukowski: (z + 1/z)/2\>\"", "->", RowBox[{"Hold", "[", RowBox[{RowBox[{"(", RowBox[{"z", "+", "1", "/", "z"}], ")"}], "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Inverse Joukowski: ArcCosh[z]\>\"", "->", RowBox[{"Hold", "[", RowBox[{"ArcCosh", "[", "z", "]"}], "]"}]}]}], "}"}], ";"}]], "Input", InitializationCell->True]
}, Open]],
Cell[CellGroupData[{
Cell["Examples", "Subsection"],
Cell["Each example is an Association with the same keys the tool edits. Expressions are wrapped in Hold so that nothing is evaluated until the tool reads them; the parameter of a curve is always called t, the variable of a map is always called z, and a region restriction uses x and y.", "Text"],
Cell[BoxData[RowBox[{"$cmtExamples", "=", RowBox[{"<|", RowBox[{RowBox[{"\"\<Parallel plates\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<Warm-up. Two infinite plates, y = 0 at V = 0 and y = 1 at V = 1. They are already lines of constant Im w, so the identity map solves the problem. The plates are open curves, so the region between them is given by the restriction 0 < y < 1.\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Bottom plate\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", "t", "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", "2"}], "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", "2", "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Curve\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Top plate\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", "t", "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", "2"}], "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", "2", "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Curve\>\""}]}], "|>"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Maps\>\"", "->", RowBox[{"{", RowBox[{"Hold", "[", "z", "]"}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Component\>\"", "->", "\"\<Im\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Region\>\"", "->", RowBox[{"Hold", "[", RowBox[{"0", "<", "y", "<", "1"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Extent\>\"", "->", "1."}]}], "|>"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Coaxial cylinders\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<A cylinder of radius 1 at V = 0 inside a cylinder of radius 2 at V = 1. Log sends circles centred on the origin to vertical lines; dividing by Log[2] moves the outer one to Re w = 1.\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Inner cylinder\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Cos", "[", "t", "]"}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Sin", "[", "t", "]"}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Hole\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Outer cylinder\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", RowBox[{"Sin", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Outer\>\""}]}], "|>"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Maps\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"Hold", "[", RowBox[{"Log", "[", "z", "]"}], "]"}], ",", RowBox[{"Hold", "[", RowBox[{"z", "/", RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Component\>\"", "->", "\"\<Re\>\""}]}], "|>"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Touching cylinders\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<A cylinder of radius 2 (V = 0) with a cylinder of radius 1 (V = 1) inside it; the two touch at z = 4 i. The M\[ODoubleDot]bius map sends the touching point to infinity, which turns both circles into parallel lines Im w = 0 and Im w = 1. (This is the example from version 1.)\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Outer cylinder\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", "2", " ", RowBox[{"Sin", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", "+", "2", " ", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Outer\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Inner cylinder\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", RowBox[{"Sin", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"3", "+", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Hole\>\""}]}], "|>"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Maps\>\"", "->", RowBox[{"{", RowBox[{"Hold", "[", RowBox[{"-", "I", " ", "z", "/", RowBox[{"(", RowBox[{"z", "-", "4", " ", "I"}], ")"}]}], "]"}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Component\>\"", "->", "\"\<Im\>\""}]}], "|>"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Confocal elliptic cylinders\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<An elliptic cylinder with semi-axes 5/4 and 3/4 (V = 0) inside a confocal one with semi-axes 5/3 and 4/3 (V = 1); both have foci at x = -1 and x = 1. ArcCosh, the inverse of the Joukowski map, straightens confocal ellipses into vertical lines.\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Inner ellipse\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"5", "/", "4", " ", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"3", "/", "4", " ", RowBox[{"Sin", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Hole\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Outer ellipse\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"5", "/", "3", " ", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"4", "/", "3", " ", RowBox[{"Sin", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Outer\>\""}]}], "|>"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Maps\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"Hold", "[", RowBox[{"ArcCosh", "[", "z", "]"}], "]"}], ",", RowBox[{"Hold", "[", RowBox[{RowBox[{"(", RowBox[{"z", "-", RowBox[{"Log", "[", "2", "]"}]}], ")"}], "/", RowBox[{"Log", "[", RowBox[{"3", "/", "2"}], "]"}]}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Component\>\"", "->", "\"\<Re\>\""}]}], "|>"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Right-angle corner\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<Two plates meeting at a right angle: the positive x-axis at V = 0 and the positive y-axis at V = 1. The plates are open curves, so the region x > 0, y > 0 is given as a restriction. Log opens the corner into a strip; the rescaling puts the plates at Im w = 0 and Im w = 1.\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Horizontal plate\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", "t", "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", "4", "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Curve\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Vertical plate\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", "t", "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", "4", "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Curve\>\""}]}], "|>"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Maps\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"Hold", "[", RowBox[{"Log", "[", "z", "]"}], "]"}], ",", RowBox[{"Hold", "[", RowBox[{"2", " ", "z", "/", "Pi"}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Component\>\"", "->", "\"\<Im\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Region\>\"", "->", RowBox[{"Hold", "[", RowBox[{"x", ">", "0", "&&", "y", ">", "0"}], "]"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Extent\>\"", "->", "1.1"}]}], "|>"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Two parallel wires\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<Two wires of radius 1 centred at x = -2 (V = -1) and x = 2 (V = 1), in otherwise empty space. Neither is inside the other. The M\[ODoubleDot]bius map (z - a)/(z + a) with a = Sqrt[3] makes the two circles concentric; Log turns them into parallel lines; the last map rescales.\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Left wire\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", "2", "+", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Sin", "[", "t", "]"}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", "1"}], "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Hole\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Right wire\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", "+", RowBox[{"Cos", "[", "t", "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Sin", "[", "t", "]"}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "1", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Hole\>\""}]}], "|>"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Maps\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"Hold", "[", RowBox[{RowBox[{"(", RowBox[{"z", "-", RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", RowBox[{"(", RowBox[{"z", "+", RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}]}], "]"}], ",", RowBox[{"Hold", "[", RowBox[{"Log", "[", "z", "]"}], "]"}], ",", RowBox[{"Hold", "[", RowBox[{"-", "z", "/", RowBox[{"Log", "[", RowBox[{"2", "+", RowBox[{"Sqrt", "[", "3", "]"}]}], "]"}]}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Component\>\"", "->", "\"\<Re\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Extent\>\"", "->", "1.6"}]}], "|>"}]}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Two wires inside a shell\>\"", "->", RowBox[{"<|", RowBox[{RowBox[{"\"\<Description\>\"", "->", "\"\<Two wires side by side (both at V = 0) inside a shell at V = 1; neither wire is inside the other. All three surfaces are Cassini ovals |z^2 - 1| = const. The map z^2 - 1 folds the two wires onto a single circle and turns the region into an annulus; Log and a rescaling finish the job.\>\""}], ",", "\[IndentingNewLine]", RowBox[{"\"\<Surfaces\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Left wire\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", RowBox[{"Re", "[", RowBox[{"Sqrt", "[", RowBox[{"1", "+", RowBox[{"Exp", "[", RowBox[{"I", " ", "t"}], "]"}], "/", "4"}], "]"}], "]"}]}], "]"}]}], ",", RowBox[{"\"\<Y\>\"", "->", RowBox[{"Hold", "[", RowBox[{"-", RowBox[{"Im", "[", RowBox[{"Sqrt", "[", RowBox[{"1", "+", RowBox[{"Exp", "[", RowBox[{"I", " ", "t"}], "]"}], "/", "4"}], "]"}], "]"}]}], "]"}]}], ",", RowBox[{"\"\<TMin\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<TMax\>\"", "->", RowBox[{"Hold", "[", RowBox[{"2", " ", "Pi"}], "]"}]}], ",", RowBox[{"\"\<V\>\"", "->", RowBox[{"Hold", "[", "0", "]"}]}], ",", RowBox[{"\"\<Role\>\"", "->", "\"\<Hole\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Name\>\"", "->", "\"\<Right wire\>\""}], ",", RowBox[{"\"\<X\>\"", "->", RowBox[{"Hold", "[", RowBox[{"Re", "[", RowBox[{"Sqrt", "[", RowBox[{"1", "+", RowBox[{"Exp", "[", Ro