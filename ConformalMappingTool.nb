o \>\"", ",", RowBox[{"numberForm", "[", RowBox[{RowBox[{"c", "[", "\"\<Range\>\"", "]"}], "[", RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", "\"\<\[LongDash]\>\""}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"statusLabel", "[", RowBox[{"c", ",", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"ListQ", "[", "exact", "]"}], "&&", RowBox[{"Length", "[", "exact", "]"}], ">=", "i"}], ",", RowBox[{"exact", "[", RowBox[{"[", "i", "]"}], "]"}], ",", "None"}], "]"}], ",", "comp"}], "]"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", RowBox[{"res", "[", "\"\<Checks\>\"", "]"}], "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Column", "[", RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{"\"\<Boundary conditions, checked in the final plane\>\"", ",", "Bold"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[{"rows", ",", "\[IndentingNewLine]", RowBox[{RowBox[{"Style", "[", RowBox[{"#", ",", "Bold"}], "]"}], "&", "/@", RowBox[{"{", RowBox[{"\"\<\>\"", ",", "\"\<Surface\>\"", ",", "\"\<Required\>\"", ",", RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"\<Actual \>\"", ",", "comp", ",", "\"\< \>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<w\>\"", ",", "Italic"}], "]"}]}], "}"}], "]"}], ",", "\"\<Status\>\""}], "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Alignment", "->", RowBox[{"{", RowBox[{"Left", ",", "Center"}], "}"}]}], ",", RowBox[{"Spacings", "->", RowBox[{"{", RowBox[{"1.5", ",", "0.6"}], "}"}]}], ",", RowBox[{"Dividers", "->", RowBox[{"{", RowBox[{"None", ",", RowBox[{"{", RowBox[{"2", "->", RowBox[{"GrayLevel", "[", "0.7", "]"}]}], "}"}]}], "}"}]}]}], "]"}]}], "}"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"legendFor", "[", "res_Association", "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"ListQ", "[", RowBox[{"res", "[", "\"\<LevelRange\>\"", "]"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"\<Equipotential colours:  \>\"", ",", RowBox[{"BarLegend", "[", RowBox[{RowBox[{"{", RowBox[{"\"\<TemperatureMap\>\"", ",", RowBox[{"res", "[", "\"\<LevelRange\>\"", "]"}]}], "}"}], ",", RowBox[{"LegendLabel", "->", "\"\<V\>\""}]}], "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", "\"\<\>\""}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"solutionPanel", "[", "res_Association", "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"comp", "=", RowBox[{"res", "[", "\"\<Component\>\"", "]"}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"Which", "[", RowBox[{RowBox[{"res", "[", "\"\<Solved\>\"", "]"}], ",", "\[IndentingNewLine]", RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{"\"\<Solved: every conductor lies on its equipotential.\>\"", ",", "Bold", ",", RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"\<Composite map:  \>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<W\>\"", ",", "Italic"}], "]"}], ",", "\"\<(\>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<z\>\"", ",", "Italic"}], "]"}], ",", "\"\<) = \>\"", ",", RowBox[{"displayForm", "[", RowBox[{"res", "[", "\"\<CompositeDisplay\>\"", "]"}], "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"\<Potential:  \>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<V\>\"", ",", "Italic"}], "]"}], ",", "\"\<(\>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<x\>\"", ",", "Italic"}], "]"}], ",", "\"\<, \>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<y\>\"", ",", "Italic"}], "]"}], ",", "\"\<) = \>\"", ",", "\[IndentingNewLine]", "comp", ",", "\"\< \>\"", ",", RowBox[{"Style", "[", RowBox[{"\"\<W\>\"", ",", "Italic"}], "]"}], ",", "\"\< = \>\"", ",", RowBox[{"displayForm", "[", RowBox[{"res", "[", "\"\<PotentialDisplay\>\"", "]"}], "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", RowBox[{"legendFor", "[", "res", "]"}]}], "}"}