}, Open]],
Cell[CellGroupData[{
Cell["Solving: boundary conditions and level curves", "Subsection"],
Cell["A conductor passes the check when, in the final plane, Re w (or Im w) equals its potential at every sampled point, within a small tolerance. Points sent to infinity are skipped. Once every conductor passes, the potential is the corresponding part of the composite map. Its level curves (the equipotentials) and the level curves of the other part (the field lines) are found in the z-plane with ContourPlot and then pushed through the maps like everything else. A contour point is kept only if the potential there really equals the level of its curve, which removes spurious lines along branch cuts.", "Text"],
Cell[BoxData[RowBox[{RowBox[{"(*", " ", RowBox[{"Points", " ", "that", " ", "land", " ", "very", " ", "far", " ", "out", " ", "are", " ", "skipped:", " ", "near", " ", "a", " ", "pole,", " ", "floating-point", " ", "error", " ", "grows", " ", "like", " ", "|w|^2,", " ", "so", " ", "their", " ", "values", " ", "say", " ", "nothing", " ", "about", " ", "the", " ", "boundary", " ", "condition.", " ", "limit", " ", "is", " ", "a", " ", "distance", " ", "well", " ", "beyond", " ", "the", " ", "final", " ", "plot", " ", "window.", " ", "The", " ", "check", " ", "is", " ", "undetermined", " ", "when", " ", "the", " ", "remaining", " ", "points", " ", "cover", " ", "less", " ", "than", " ", "half", " ", "of", " ", "the", " ", "t", " ", "range."}], " ", "*)"}], "\[IndentingNewLine]", RowBox[{"boundaryCheck", "[", RowBox[{"surf_Association", ",", "z_List", ",", "m_List", ",", "comp_String", ",", "limit_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"near", ",", "good", ",", "vals", ",", "resid", ",", "tol", ",", RowBox[{"ts", "=", RowBox[{"surf", "[", "\"\<T\>\"", "]"}]}], ",", "coverage"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"near", "=", RowBox[{"If", "[", RowBox[{RowBox[{"m", "===", RowBox[{"{", "}"}]}], ",", RowBox[{"{", "}"}], ",", RowBox[{"m", " ", RowBox[{"(", RowBox[{"1", "-", RowBox[{"UnitStep", "[", RowBox[{RowBox[{"Abs", "[", "z", "]"}], "-", "limit"}], "]"}]}], ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", "good", "=", RowBox[{"Flatten", "[", RowBox[{"Position", "[", RowBox[{"near", ",", "1"}], "]"}], "]"}], ";", "\[IndentingNewLine]", "vals", "=", RowBox[{"If", "[", RowBox[{RowBox[{"comp", "===", "\"\<Re\>\""}], ",", RowBox[{"Re", "[", RowBox[{"z", "[", RowBox[{"[", "good", "]"}], "]"}], "]"}], ",", RowBox[{"Im", "[", RowBox[{"z", "[", RowBox[{"[", "good", "]"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "coverage", "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "ts", "]"}], "<", "2"}], ",", "0", ",", "\[IndentingNewLine]", RowBox[{RowBox[{"Total", "[", RowBox[{RowBox[{"Differences", "[", "ts", "]"}], " ", RowBox[{"Most", "[", "near", "]"}], " ", RowBox[{"Rest", "[", "near", "]"}]}], "]"}], "/", RowBox[{"(", RowBox[{RowBox[{"Last", "[", "ts", "]"}], "-", RowBox[{"First", "[", "ts", "]"}]}], ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Which", "[", RowBox[{RowBox[{RowBox[{"surf", "[", "\"\<Error\>\"", "]"}], "=!=", "None"}], ",", RowBox[{"<|", RowBox[{"\"\<Status\>\"", "->", "\"\<Error\>\""}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{RowBox[{"Length", "[", "good", "]"}], "<", "2", "||", "coverage", "<", "0.5"}], ",", RowBox[{"<|", RowBox[{"\"\<Status\>\"", "->", "\"\<Undetermined\>\""}], "|>"}], ",", "\[IndentingNewLine]", RowBox[{RowBox[{"(*", " ", RowBox[{"a", " ", "surface", " ", "with", " ", "unknown", " ", "potential", " ", "is", " ", "not", " ", "checked,", " ", "but", " ", "we", " ", "report", " ", "where", " ", "it", " ", "landed"}], " ", "*)"}], "\[IndentingNewLine]", "!", RowBox[{"TrueQ", "[", RowBox[{"surf", "[", "\"\<CheckV\>\"", "]"}], "]"}]}], ",", RowBox[{"<|", RowBox[{RowBox[{"\"\<Status\>\"", "->", "\"\<Unchecked\>\""}], ",", RowBox[{"\"\<Range\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"Min", "[", "vals", "]"}], ",", RowBox[{"Max", "[", "vals", "]"}]}], "}"}]}]}], "|>"}], ",", "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", RowBox[{"resid", "=", RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[{"vals", "-", RowBox[{RowBox[{"surf", "[", "\"\<V\>\"", "]"}], "[", RowBox[{"[", "good", "]"}], "]"}]}], "]"}], "]"}], ";", "\[IndentingNewLine]", "tol", "=", "10.", "^", "-", "6", " ", RowBox[{"(", RowBox[{"1", "+", RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[{"surf", "[", "\"\<V\>\"", "]"}], "]"}], "]"}]}], ")"}], ";", "\[IndentingNewLine]", RowBox[{"<|", RowBox[{RowBox[{"\"\<Status\>\"", "->", RowBox[{"If", "[", RowBox[{RowBox[{"resid", "<=", "tol"}], ",", "\"\<Pass\>\"", ",", "\"\<Fail\>\""}], "]"}]}], ",", RowBox[{"\"\<Residual\>\"", "->", "resid"}], ",", RowBox[{"\"\<Range\>\"", "->", RowBox[{"{", RowBox[{RowBox[{"Min", "[", "vals", "]"}], ",", RowBox[{"Max", "[", "vals", "]"}]}], "}"}]}]}], "|>"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"levelRange", "[", RowBox[{"vals_List", ",", "extra_List"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"q", "=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "vals", "]"}], ">", "10"}], ",", RowBox[{"Quantile", "[", RowBox[{"vals", ",", RowBox[{"{", RowBox[{"0.02", ",", "0.98"}], "}"}]}], "]"}], ",", RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Join", "[", RowBox[{"q", ",", "extra"}], "]"}], "===", RowBox[{"{", "}"}]}], ",", RowBox[{"{", RowBox[{"0.", ",", "0."}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"Min", "[", RowBox[{"Join", "[", RowBox[{"q", ",", "extra"}], "]"}], "]"}], ",", RowBox[{"Max", "[", RowBox[{"Join", "[", RowBox[{"q", ",", "extra"}], "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"evenLevels", "[", RowBox[{"lo_", ",", "hi_", ",", "count_Integer"}], "]"}], ":=", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"count", "<", "1", "||", "hi", "-", "lo", "<=", "10.", "^", "-", "9"}], ",", RowBox[{"{", "}"}], ",", RowBox[{"lo", "+", RowBox[{"(", RowBox[{"hi", "-", "lo"}], ")"}], " ", RowBox[{"Range", "[", "count", "]"}], "/", RowBox[{"(", RowBox[{"count", "+", "1."}], ")"}]}]}], "]"}], ";"}]], "Input", InitializationCell->True],
Cell[BoxData[RowBox[{RowBox[{"(*", " ", RowBox[{"Numerical", " ", "inverse", " ", "of", " ", "the", " ", "composite", " ", "map:", " ", "Newton's", " ", "method", " ", "on", " ", "W(z)", " ", "=", " ", "target,", " ", "started", " ", "from", " ", "seeds", " ", "z0", " ", "that", " ", "are", " ", "known", " ", "points", " ", "of", " ", "the", " ", "region.", " ", "The", " ", "branch", " ", "is", " ", "chosen", " ", "by", " ", "the", " ", "region", " ", "itself,", " ", "through", " ", "the", " ", "seeds,", " ", "so", " ", "no", " ", "symbolic", " ", "inverse", " ", "or", " ", "branch", " ", "choice", " ", "is", " ", "needed.", " ", "Steps", " ", "are", " ", "capped", " ", "at", " ", "maxStep.", " ", "Returns", " ", "{ok,", " ", "z}."}], " ", "*)"}], "\[IndentingNewLine]", RowBox[{"newtonSolve", "[", RowBox[{"w_", ",", "dw_", ",", "targets_List", ",", "z0_List", ",", "maxStep_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"z", "=", "z0"}], ",", "ok", ",", "okf", ",", "okd", ",", "f", ",", "d", ",", "step"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"ok", "=", RowBox[{"ConstantArray", "[", RowBox[{"1", ",", RowBox[{"Length", "[", "z0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"{", RowBox[{"okf", ",", "f"}], "}"}], "=", RowBox[{"cleanValues", "[", RowBox[{"evaluateOn", "[", RowBox[{"w", ",", "\[FormalZ]", ",", "z"}], "]"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"okd", ",", "d"}], "}"}], "=", RowBox[{"cleanValues", "[", RowBox[{"evaluateOn", "[", RowBox[{"dw", ",", "\[FormalZ]", ",", "z"}], "]"}], "]"}], ";", "\[IndentingNewLine]", "ok", "=", "ok", " ", "okf", " ", "okd", " ", RowBox[{"UnitStep", "[", RowBox[{RowBox[{"Abs", "[", "d", "]"}], "-", "10.", "^", "-", "14"}], "]"}], ";", "\[IndentingNewLine]", "d", "=", "d", "+", RowBox[{"(", RowBox[{"1", "-", "ok"}], ")"}], ";", "\[IndentingNewLine]", "step", "=", "ok", " ", RowBox[{"(", RowBox[{"f", "-", "targets"}], ")"}], "/", "d", ";", "\[IndentingNewLine]", "z", "=", "z", "-", "step", "/", RowBox[{"(", RowBox[{"1", "+", RowBox[{"Ramp", "[", RowBox[{RowBox[{"Abs", "[", "step", "]"}], "/", "maxStep", "-", "1"}], "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", RowBox[{"{", "12", "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"okf", ",", "f"}], "}"}], "=", RowBox[{"cleanValues", "[", RowBox[{"evaluateOn", "[", RowBox[{"w", ",", "\[FormalZ]", ",", "z"}], "]"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{"ok", " ", "okf", " ", RowBox[{"UnitStep", "[", RowBox[{"10.", "^", "-", "9", " ", RowBox[{"(", RowBox[{"1", "+", RowBox[{"Abs", "[", "targets", "]"}]}], ")"}], "-", RowBox[{"Abs", "[", RowBox[{"f", "-", "targets"}], "]"}]}], "]"}]}], ",", "z"}], "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"nearestIndices", "[", RowBox[{"data_List", ",", "queries_List", ",", "k_Integer"}], "]"}], ":=", RowBox[{RowBox[{"Nearest", "[", RowBox[{"data", "->", "Automatic"}], "]"}], "[", RowBox[{"queries", ",", "k"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"(*", " ", RowBox[{"The", " ", "solution", " ", "mesh.", " ", "In", " ", "the", " ", "final", " ", "plane", " ", "the", " ", "potential", " ", "a", " ", "and", " ", "its", " ", "conjugate", " ", "b", " ", "are", " ", "Cartesian", " ", "coordinates,", " ", "so", " ", "the", " ", "mesh", " ", "is", " ", "built", " ", "there:", " ", "a", " ", "grid", " ", "of", " ", "square", " ", "cells", " ", "whose", " ", "lines", " ", "include", " ", "every", " ", "equipotential", " ", "(a", " ", "=", " ", "level)", " ", "and", " ", "every", " ", "field", " ", "line", " ", "(b", " ", "=", " ", "level).", " ", "Each", " ", "cell", " ", "is", " ", "pulled", " ", "back", " ", "to", " ", "the", " ", "z-plane", " ", "through", " ", "the", " ", "numerical", " ", "inverse;", " ", "a", " ", "map", " ", "that", " ", "is", " ", "several-to-one", " ", "gives", " ", "one", " ", "copy", " ", "of", " ", "the", " ", "cell", " ", "for", " ", "each", " ", "preimage", " ", "in", " ", "the", " ", "region.", " ", "The", " ", "result", " ", "is", " ", "the", " ", "net", " ", "of", " ", "curvilinear", " ", "squares,", " ", "with", " ", "the", " ", "equipotentials", " ", "and", " ", "field", " ", "lines", " ", "as", " ", "exact", " ", "edges", " ", "of", " ", "the", " ", "cells."}], " ", "*)"}], "\[IndentingNewLine]", RowBox[{"solutionMesh", "[", RowBox[{"w_", ",", "comp_String", ",", "seedZ_List", ",", "seedW_List", ",", "maskFn_", ",", "box_", ",", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"loA_", ",", "hiA_", ",", "nA_Integer"}], "}"}], ",", RowBox[{"{", RowBox[{"loB_", ",", "hiB_", ",", "nB_Integer"}], "}"}], ",", RowBox[{"{", RowBox[{"aMin_", ",", "aMax_"}], "}"}], ",", RowBox[{"{", RowBox[{"bMin_", ",", "bMax_"}], "}"}], ",", "nTarget_Integer"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"dw", "=", RowBox[{"D", "[", RowBox[{"w", ",", "\[FormalZ]"}], "]"}]}], ",", "toW", ",", "da", ",", "db", ",", "h", ",", "sa", ",", "sb", ",", "ha", ",", "hb", ",", "cellsAB", ",", "ac", ",", "bc", ",", "wc", ",", "near", ",", "owner", ",", "ok", ",", "zc", ",", "cand", ",", "\[IndentingNewLine]", "inRegion", ",", "acc", ",", "bcc", ",", "corners", ",", "cz", ",", "okc", ",", "dwc", ",", "far", ",", "keep", ",", "ia", ",", "ib", ",", "base", ",", "eq", ",", "fl", ",", "maxStep", ",", "tol"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"toW", "=", RowBox[{"If", "[", RowBox[{RowBox[{"comp", "===", "\"\<Re\>\""}], ",", RowBox[{"#1", "+", "I", " ", "#2", "&"}], ",", RowBox[{"#2", "+", "I", " ", "#1", "&"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"(*", " ", RowBox[{"the", " ", "spacing", " ", "of", " ", "the", " ", "lines,", " ", "and", " ", "square", " ", "cells", " ", "that", " ", "subdivide", " ", "the", " ", "blocks", " ", "between", " ", "them"}], " ", "*)"}], "\[IndentingNewLine]", "da", "=", RowBox[{"(", RowBox[{"hiA", "-", "loA"}], ")"}], "/", RowBox[{"(", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"nA", ">", "0"}], ",", "nA", ",", "7"}], "]"}], "+", "1"}], ")"}], ";", "\[IndentingNewLine]", "db", "=", RowBox[{"(", RowBox[{"hiB", "-", "loB"}], ")"}], "/", RowBox[{"(", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"nB", ">", "0"}], ",", "nB", ",", "7"}], "]"}], "+", "1"}], ")"}], ";", "\[IndentingNewLine]", "h", "=", RowBox[{"Min", "[", RowBox[{"da", ",", "db"}], "]"}], "/", "6", ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{"aMax", "-", "aMin"}], ")"}], " ", RowBox[{"(", RowBox[{"bMax", "-", "bMin"}], ")"}], "/", "h", "^", "2", ">", "nTarget"}], ",", RowBox[{"h", "=", RowBox[{"Sqrt", "[", RowBox[{RowBox[{"(", RowBox[{"aMax", "-", "aMin"}], ")"}], " ", RowBox[{"(", RowBox[{"bMax", "-", "bMin"}], ")"}], "/", "nTarget"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "sa", "=", RowBox[{"Max", "[", RowBox[{"1", ",", RowBox[{"Round", "[", RowBox[{"da", "/", "h"}], "]"}]}], "]"}], ";", "sb", "=", RowBox[{"Max", "[", RowBox[{"1", ",", RowBox[{"Round", "[", RowBox[{"db", "/", "h"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "ha", "=", "da", "/", "sa", ";", "hb", "=", "db", "/", "sb", ";", "\[IndentingNewLine]", "cellsAB", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Floor", "[", RowBox[{RowBox[{"(", RowBox[{"aMin", "-", "loA"}], ")"}], "/", "ha"}], "]"}], ",", RowBox[{RowBox[{"Ceiling", "[", RowBox[{RowBox[{"(", RowBox[{"aMax", "-", "loA"}], ")"}], "/", "ha"}], "]"}], "-", "1"}]}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"j", ",", RowBox[{"Floor", "[", RowBox[{RowBox[{"(", RowBox[{"bMin", "-", "loB"}], ")"}], "/", "hb"}], "]"}], ",", RowBox[{RowBox[{"Ceiling", "[", RowBox[{RowBox[{"(", RowBox[{"bMax", "-", "loB"}], ")"}], "/", "hb"}], "]"}], "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ";", "\[IndentingNewLine]", RowB