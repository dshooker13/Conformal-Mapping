Cell[CellGroupData[{
Cell["Geometry: the region, and pushing points through the maps", "Subsection"],
Cell["The region is: inside the view box, inside the outer boundary (if there is one), outside every conductor marked as inside the region, and satisfying the optional restriction. Nothing here assumes that one surface is inside another, so conductors can sit side by side. Points are tested with the even-odd rule against each sampled curve.", "Text"],
Cell[BoxData[RowBox[{RowBox[{"(*", " ", RowBox[{"1", " ", "where", " ", "a", " ", "point", " ", "is", " ", "inside", " ", "the", " ", "closed", " ", "sampled", " ", "curve,", " ", "0", " ", "where", " ", "it", " ", "is", " ", "outside", " ", "(even-odd", " ", "rule)."}], " ", "*)"}], "\[IndentingNewLine]", RowBox[{"insideCurve", "[", RowBox[{"curve_List", ",", "zs_List"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"x", "=", RowBox[{"Re", "[", "zs", "]"}]}], ",", RowBox[{"y", "=", RowBox[{"Im", "[", "zs", "]"}]}], ",", RowBox[{"n", "=", RowBox[{"Length", "[", "curve", "]"}]}], ",", "cnt", ",", "xi", ",", "yi", ",", "xj", ",", "yj"}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"cnt", "=", RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[{"Length", "[", "zs", "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"{", RowBox[{"xi", ",", "yi"}], "}"}], "=", RowBox[{"{", RowBox[{RowBox[{"Re", "[", RowBox[{"curve", "[", RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", RowBox[{"Im", "[", RowBox[{"curve", "[", RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"xj", ",", "yj"}], "}"}], "=", RowBox[{"{", RowBox[{RowBox[{"Re", "[", RowBox[{"curve", "[", RowBox[{"[", RowBox[{RowBox[{"Mod", "[", RowBox[{"i", ",", "n"}], "]"}], "+", "1"}], "]"}], "]"}], "]"}], ",", RowBox[{"Im", "[", RowBox[{"curve", "[", RowBox[{"[", RowBox[{RowBox[{"Mod", "[", RowBox[{"i", ",", "n"}], "]"}], "+", "1"}], "]"}], "]"}], "]"}]}], "}"}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"yi", "!=", "yj"}], ",", "\[IndentingNewLine]", RowBox[{"cnt", "+=", RowBox[{"Abs", "[", RowBox[{RowBox[{"UnitStep", "[", RowBox[{"y", "-", "yi"}], "]"}], "-", RowBox[{"UnitStep", "[", RowBox[{"y", "-", "yj"}], "]"}]}], "]"}], " ", RowBox[{"UnitStep", "[", RowBox[{"xi", "+", RowBox[{"(", RowBox[{"xj", "-", "xi"}], ")"}], " ", RowBox[{"(", RowBox[{"y", "-", "yi"}], ")"}], "/", RowBox[{"(", RowBox