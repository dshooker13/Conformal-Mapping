Cell[CellGroupData[{
Cell["Drawing", "Subsection"],
Cell["The stage s runs from 0 (the z-plane) to n (the final plane). Between whole numbers the picture is a straight-line blend of the two neighbouring planes, point by point. Lines are broken wherever a point is missing or two neighbouring points are far apart, which happens across a branch cut or near a pole.", "Text"],
Cell[BoxData[RowBox[{RowBox[{"surfaceColor", "[", "i_Integer", "]"}], ":=", RowBox[{RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"(*", " ", RowBox[{"The", " ", "default", " ", "colour", " ", "Mathematica", " ", "uses", " ", "for", " ", "filled", " ", "regions;", " ", "drawn", " ", "translucent", " ", "so", " ", "it", " ", "works", " ", "in", " ", "light", " ", "and", " ", "dark", " ", "themes."}], " ", "*)"}], "\[IndentingNewLine]", "$cmtRegionColor", "=", RowBox[{"RGBColor", "[", RowBox[{"0.368417", ",", "0.506779", ",", "0.709798"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"potentialColor", "[", RowBox[{"v_", ",", RowBox[{"{", RowBox[{"lo_", ",", "hi_"}], "}"}]}], "]"}], ":=", RowBox[{RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], "[", RowBox[{"If", "[", RowBox[{RowBox[{"hi", ">", "lo"}], ",", RowBox[{RowBox[{"(", RowBox[{"v", "-", "lo"}], ")"}], "/", RowBox[{"(", RowBox[{"hi", "-", "lo"}], ")"}]}], ",", "0.5"}], "]"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"potentialColor", "[", RowBox[{"v_", ",", "_"}], "]"}], ":=", RowBox[{"GrayLevel", "[", "0.5", "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"stageIndex", "[", RowBox[{"s_", ",", "n_Integer"}], "]"}], ":=", RowBox[{"Which", "[", RowBox[{RowBox[{"n", "==", "0", "||", "s", "<=", "0"}], ",", RowBox[{"{", RowBox[{"0", ",", "0."}], "}"}], ",", "\[IndentingNewLine]", RowBox[{"s", ">=", "n"}], ",", RowBox[{"{", RowBox[{RowBox[{"n", "-", "1"}], ",", "1."}], "}"}], ",", "\[IndentingNewLine]", "True", ",", RowBox[{"{", RowBox[{RowBox[{"Floor", "[", "s", "]"}], ",", RowBox[{"s", "-", RowBox[{"Floor", "[", "s", "]"}]}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{"framePoints", "[", RowBox[{"fam_Association", ",", "k_Integer", ",", "u_"}], "]"}], ":=", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"p", "=", RowBox[{"fam", "[", "\"\<Planes\>\"", "]"