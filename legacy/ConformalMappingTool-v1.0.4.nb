          Length[$CellContext`winv]]]], ControlType -> Automatic}, {
       Hold[$CellContext`time$$], 0, 1, ControlType -> Manipulator}, {
       Hold[
        Style["Finalizing", 16]], Manipulate`Dump`ThisIsNotAControl, 
       ControlType -> None}, {{
        Hold[$CellContext`f$$], 1, "f: "}, {1 -> "x", 2 -> "y"}, ControlType -> 
       RadioButtonBar}, {
       Hold[
        Button["Check V(w(t))", 
         If[
          $CellContext`check[$CellContext`trange$$, $CellContext`Vs, 
