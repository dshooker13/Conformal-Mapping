$CellContext`zint]}], Enabled -> Dynamic[
           And[$CellContext`to$$ != $CellContext`tf$$, {
              ReleaseHold[
               
               ReplaceAll[$CellContext`sx$$, $CellContext`t$$ -> \
$CellContext`to$$]]} == {
              ReleaseHold[
               
               ReplaceAll[$CellContext`sx$$, $CellContext`t$$ -> \
$CellContext`tf$$]]}, {
              ReleaseHold[
               
               ReplaceAll[$CellContext`sy$$, $CellContext`t$$ -> \
$CellContext`to$$]]} == {
              ReleaseHold[
               
               ReplaceAll[$CellContext`sy$$, $CellContext`t$$ -> \
$CellContext`tf$$]]}, $CellContext`S1$$ != $CellContext`S2$$]]]], 
       Manipulate`Dump`ThisIsNotAControl, ControlType -> None}, {
