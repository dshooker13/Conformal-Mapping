             I $CellContext`v}, $CellContext`j = 1, 
           
           While[$CellContext`j <= 
            Length[$CellContext`ws], {$CellContext`xy = ReplaceAll[
               
               Part[$CellContext`ws, $CellContext`j], $CellContext`zint -> \
$CellContext`xy], $CellContext`equi = Append[$CellContext`equi, 
               ReplaceAll[
                
                Part[$CellContext`inverses, 
