$CellContext`trange$$ = {{0, 2 Pi}, {0, 2 Pi}}, $CellContext`t$$}, 
  TagBox[
   StyleBox[
    DynamicModuleBox[{$CellContext`autopp$$ = True, $CellContext`autorec$$ = 
     True, $CellContext`f$$ = 1, $CellContext`Name$$ = 
     "Surface 2", $CellContext`neq$$ = 0, $CellContext`opt$$ = 
     None, $CellContext`perf1$$ = 50, $CellContext`perf2$$ = 
     50, $CellContext`rec$$ = 1, $CellContext`S1$$ = 1, $CellContext`S2$$ = 
     4, $CellContext`Surface$$ = 2, $CellContext`sx$$ = 
     Hold[-Sin[$CellContext`t]], $CellContext`sy$$ = Hold[
     3 + Cos[$CellContext`t]], $CellContext`tf$$ = 2 Pi, $CellContext`time$$ =
      0, $CellContext`to$$ = 0, $CellContext`Transformation$$ = 
     1, $CellContext`V$$ = 0, $CellContext`w$$ = 0, $CellContext`wi$$ = Null, 
     Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
     Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
     1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{
       Hold[
        Style["Surfaces", 16]], Manipulate`Dump`ThisIsNotAControl, 
       ControlType -> None}, {
       Hold[
        Grid[{{"Add/Remove", 
           
           ButtonBar[{
            "+" :> $CellContext`adds$$[], "-" :> 
             If[Length[$CellContext`surfaces] - 2 > 
               1, $CellContext`rems$$[$CellContext`Surface$$]; \
$CellContext`Surface$$ = 1]}, Enabled -> Dynamic[
              Not[$CellContext`finalanswer]]]}}]], 
       Manipulate`Dump`ThisIsNotAControl, ControlType -> None}, {{
        Hold[$CellContext`Surface$$], 1}, 
       Dynamic[
        Array[# -> ToString[
           Part[$CellContext`names, #]]& , Length[$CellContext`surfaces] - 
         2]], ControlType -> Automatic}, {{
        Hold[$CellContext`Name$$], "", "Name:"}, 
       Dynamic[InputField[
         Dynamic[
          StringTrim[
           ToString[$CellContext`Name$$], 
           Alternatives["{", "}"]], With[{$CellContext`s$ = #}, 
           If[
            StringQ[$CellContext`s$], 
            Part[$CellContext`names, $CellContext`Surface$$] = \
$CellContext`s$; $CellContext`Name$$ = $CellContext`s$; $CellContext`time$$ = 
             1 - $CellContext`time$$; $CellContext`time$$ = 
             1 - $CellContext`time$$]]& ], String]& ], ControlType -> 
       Automatic}, {{
        Hold[$CellContext`sx$$], 0, "\!\(\*SubscriptBox[\(S\), \(x\)]\)(t)"}, 
       InputField[#, 
        Hold[Expression]]& , ControlType -> InputField}, {{
        Hold[$CellContext`sy$$], 0, "\!\(\*SubscriptBox[\(S\), \(y\)]\)(t)"}, 
       InputField[#, 
        Hold[Expression]]& , ControlType -> InputField}, {{
        Hold[$CellContext`V$$], 0, "V(t)"}, InputField[#, 
        Hold[Expression]]& , ControlType -> InputField}, {{
        Hold[$CellContext`to$$], 0, "\!\(\*SubscriptBox[\(t\), \(min\)]\)"}, 
       ControlType -> InputField}, {{
        Hold[$CellContext`tf$$], 1, "\!\(\*SubscriptBox[\(t\), \(max\)]\)"}, 
       ControlType -> InputField}, {
       Hold[
        Style["Bounding surface", 16]], Manipulate`Dump`ThisIsNotAControl, 
       ControlType -> None}, {{
        Hold[$CellContext`S1$$], 1, "Surface 1"}, 
       Dynamic[
        Array[# -> "Surface " <> ToString[#]& , Length[$CellContext`surfaces] - 
         2]], ControlType -> Automatic}, {{
        Hold[$CellContext`S2$$], 1, "Surface 2"}, 
       Dynamic[
        Join[
         Array[# -> "Surface " <> ToString[#]& , 
          Length[$CellContext`surfaces] - 2], {
         Length[$CellContext`surfaces] - 1 -> "Origin", 
          Length[$CellContext`surfaces] -> "Infinity"}]], ControlType -> 
       Automatic}, {
       Hold[
        Style["Transformations", 16]], Manipulate`Dump`ThisIsNotAControl, 
       ControlType -> None}, {
       Hold[
        Grid[{{"Add/Remove", 
           
